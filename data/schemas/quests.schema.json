{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Quêtes",
	"description": "Quêtes pilotées par les données (voir scripts/systems/quests/quest_log.gd). Une cible de lieu s'écrit « lieu » ou « lieu:repère ».",
	"type": "object",
	"required": [
		"quests"
	],
	"additionalProperties": false,
	"properties": {
		"quests": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"name",
					"summary",
					"giver",
					"zone",
					"beat",
					"steps"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"name": {
						"type": "string",
						"pattern": "^QUEST_[A-Z0-9_]+$"
					},
					"summary": {
						"type": "string",
						"pattern": "^QUEST_[A-Z0-9_]+_SUMMARY$"
					},
					"giver": {
						"type": "string"
					},
					"zone": {
						"type": "string"
					},
					"requires": {
						"type": "object",
						"description": "Condition de départ (voir conditions.gd)."
					},
					"beat": {
						"type": "object",
						"required": [
							"type",
							"intensity"
						],
						"additionalProperties": false,
						"description": "Place de la quête dans le rythme de l'acte.",
						"properties": {
							"type": {
								"enum": [
									"teach",
									"explore",
									"tension",
									"stealth",
									"action",
									"rest",
									"climax"
								]
							},
							"intensity": {
								"type": "number",
								"minimum": 0,
								"maximum": 1
							}
						}
					},
					"steps": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": [
								"id",
								"type",
								"target",
								"text"
							],
							"additionalProperties": false,
							"properties": {
								"id": {
									"type": "string",
									"pattern": "^[a-z][a-z0-9_]*$"
								},
								"type": {
									"enum": [
										"TALK",
										"GOTO",
										"COLLECT",
										"DELIVER",
										"USE",
										"PUBLISH",
										"SABOTAGE",
										"HACK",
										"ESCORT",
										"STEALTH",
										"DEFEND",
										"NEUTRALIZE"
									]
								},
								"target": {
									"type": "string"
								},
								"count": {
									"type": "integer",
									"minimum": 1
								},
								"text": {
									"type": "string",
									"pattern": "^OBJ_[A-Z0-9_]+$"
								},
								"where": {
									"type": "string",
									"description": "Où trouver la cible : « lieu:repère »."
								},
								"next": {
									"type": "string"
								},
								"end": {
									"type": "boolean"
								},
								"branches": {
									"type": "array"
								},
								"effects": {
									"type": "object"
								},
								"dialogue": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"minItems": 2,
									"maxItems": 2
								},
								"waves": {
									"type": "array",
									"items": {
										"type": "integer",
										"minimum": 1
									},
									"description": "DEFEND : taille de chaque vague de Vigiles, dans l'ordre."
								},
								"spawn": {
									"type": "string",
									"description": "DEFEND : repère d'arrivée des Vigiles."
								},
								"enemy": {
									"type": "string",
									"description": "DEFEND : personnage des Vigiles (data/characters/)."
								}
							}
						}
					},
					"rewards": {
						"type": "object"
					}
				}
			}
		}
	}
}
