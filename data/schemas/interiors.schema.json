{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Intérieur",
	"description": "Un lieu intérieur dessiné en texte, une case par mètre (voir scripts/systems/world/interior_builder.gd) : « # » mur, majuscule pan de mur particulier, espace vide, le reste du sol ; minuscule ou chiffre : un repère.",
	"type": "object",
	"required": [
		"id",
		"name",
		"territory",
		"plan",
		"markers"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"name": {
			"type": "string",
			"pattern": "^PLACE_[A-Z0-9_]+$"
		},
		"territory": {
			"type": "string",
			"description": "Zone de territoire qui abrite ce lieu."
		},
		"home": {
			"type": "boolean",
			"description": "Un logement : il garde ses couleurs même sous le régime."
		},
		"plan": {
			"type": "array",
			"minItems": 3,
			"items": {
				"type": "string",
				"minLength": 3
			}
		},
		"markers": {
			"type": "object",
			"description": "Caractère du plan → nom du repère. Il en faut un nommé « default ».",
			"propertyNames": {
				"minLength": 1,
				"maxLength": 1
			},
			"additionalProperties": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9_]*$"
			}
		},
		"floors": {
			"type": "object",
			"description": "Caractère du plan → couleur de la palette pour ce sol.",
			"propertyNames": {
				"minLength": 1,
				"maxLength": 1
			},
			"additionalProperties": {
				"type": "string"
			}
		},
		"floor_color": {
			"type": "string"
		},
		"wall_color": {
			"type": "string"
		},
		"doors": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"at",
					"to",
					"prompt"
				],
				"additionalProperties": false,
				"properties": {
					"at": {
						"type": "string",
						"description": "Repère où se trouve la porte."
					},
					"to": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*(@[a-z0-9_]+)?$",
						"description": "Lieu d'arrivée, avec ou sans repère : « hall_tour », « grigny2@gare »."
					},
					"prompt": {
						"type": "string",
						"pattern": "^[A-Z][A-Z0-9_]*$"
					},
					"dialogue": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 2,
						"maxItems": 2,
						"description": "[fichier, entrée] : on frappe, et le dialogue décide si l'on entre."
					}
				}
			}
		},
		"props": {
			"type": "object",
			"description": "Caractère du plan → meuble. Des cases voisines de même caractère forment un seul meuble.",
			"propertyNames": {
				"minLength": 1,
				"maxLength": 1
			},
			"additionalProperties": {
				"type": "object",
				"required": [
					"model"
				],
				"additionalProperties": false,
				"properties": {
					"model": {
						"type": "string",
						"description": "Modèle de assets_src/voxel/props/."
					},
					"yaw": {
						"type": "number",
						"description": "Rotation en degrés ; à 0, l'avant du modèle regarde le nord (haut du plan)."
					},
					"solid": {
						"type": "boolean",
						"description": "Faux : on passe à travers (chaise, tapis)."
					}
				}
			}
		},
		"pickups": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"item",
					"at"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$",
						"description": "Unique dans le lieu : un objet pris ne revient pas."
					},
					"item": {
						"type": "string"
					},
					"at": {
						"type": "string",
						"description": "Repère où l'objet est posé."
					},
					"count": {
						"type": "integer",
						"minimum": 1
					}
				}
			}
		},
		"npcs": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"character",
					"at"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"character": {
						"type": "string",
						"description": "Fiche de data/characters/."
					},
					"at": {
						"type": "string",
						"description": "Repère où se tient le personnage."
					},
					"dialogue": {
						"type": "string",
						"description": "Fichier de dialogue/ (sans extension)."
					},
					"cue": {
						"type": "string"
					},
					"yaw": {
						"type": "number"
					},
					"if": {
						"type": "object",
						"description": "Condition de présence (voir scripts/systems/quests/conditions.gd)."
					}
				}
			}
		},
		"spots": {
			"type": "array",
			"description": "Points d'action : interagir joue un dialogue (lit, mur à taguer, boîtier).",
			"items": {
				"type": "object",
				"required": [
					"id",
					"at",
					"prompt",
					"dialogue"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"at": {
						"type": "string",
						"description": "Repère du point."
					},
					"prompt": {
						"type": "string",
						"description": "Clé du verbe affiché."
					},
					"dialogue": {
						"type": "array",
						"description": "[fichier de dialogue/, entrée].",
						"items": {
							"type": "string"
						},
						"minItems": 2,
						"maxItems": 2
					},
					"if": {
						"type": "object",
						"description": "Condition pour que le geste soit possible (voir conditions.gd)."
					},
					"offence": {
						"type": "boolean",
						"description": "Vrai pour un geste interdit : les guetteurs qui voient Akan s'inquiètent."
					}
				}
			}
		},
		"cameras": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"at"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"at": {
						"type": "string",
						"description": "Repère ou « x,z »."
					},
					"yaw": {
						"type": "number",
						"description": "Axe du regard, en degrés (0 : vers le nord)."
					},
					"sweep": {
						"type": "number",
						"description": "Balayage de part et d'autre de l'axe, en degrés."
					},
					"range": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"if": {
						"type": "object"
					}
				}
			}
		},
		"vigiles": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"patrol"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"character": {
						"type": "string"
					},
					"patrol": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string"
						},
						"description": "La ronde : repères ou « x,z », parcourus en boucle."
					},
					"if": {
						"type": "object"
					}
				}
			}
		}
	}
}
